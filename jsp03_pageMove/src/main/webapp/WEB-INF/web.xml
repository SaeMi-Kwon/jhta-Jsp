<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
xmlns="https://jakarta.ee/xml/ns/jakartaee" 
xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee 
			https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd" 
id="WebApp_ID" version="6.0">
  <display-name>jsp03_pageMove</display-name>
  <welcome-file-list>
    <welcome-file>index.html</welcome-file>
    <welcome-file>index.jsp</welcome-file>
    <welcome-file>index.htm</welcome-file>
    <welcome-file>default.html</welcome-file>
    <welcome-file>default.jsp</welcome-file>
    <welcome-file>default.htm</welcome-file>
  </welcome-file-list>
  
  <!--///////////// 서블릿 매핑하기 ////////////////////-->
  <servlet>
  	<!-- <servlet-name> : 패키지명.클래스명의 alias같은 역할 -->
  	<servlet-name>loginServlet</servlet-name>  
  	<servlet-class>servlet.LoginServlet</servlet-class>  <!-- 패키지명.클래스명 -->
  </servlet>
  <servlet-mapping>
  	<servlet-name>loginServlet</servlet-name>
  	<url-pattern>/login</url-pattern>  <!-- 경로 -->
  </servlet-mapping>
  
  <servlet>
  	<servlet-name>JoinServlet</servlet-name>
  	<servlet-class>servlet.JoinServlet</servlet-class>
  </servlet>
  <servlet-mapping>
  	<servlet-name>JoinServlet</servlet-name>
  	<url-pattern>/join</url-pattern>
  </servlet-mapping>
  
  
  <!--///////////////////////////////////////////////-->
  
</web-app>